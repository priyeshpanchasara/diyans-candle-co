    // =========================================================================
    // 3. INITIALIZATION & LOCAL STORAGE SYNC
    // =========================================================================
    function initApp() {
      try {
        const savedProducts = localStorage.getItem(STORAGE_KEY_PRODUCTS);
        products = savedProducts ? JSON.parse(savedProducts) : [...DEFAULT_PRODUCTS];
        if (!Array.isArray(products) || products.length === 0) {
          products = [...DEFAULT_PRODUCTS];
        }
      } catch (e) {
        products = [...DEFAULT_PRODUCTS];
      }

      try {
        const savedCart = localStorage.getItem(STORAGE_KEY_CART);
        cart = savedCart ? JSON.parse(savedCart) : {};
      } catch (e) {
        cart = {};
      }

      renderCategoryPills();
      renderProducts();
      updateCartUI();
    }

    function saveProductsToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_PRODUCTS, JSON.stringify(products));
      } catch (e) {
        console.warn('Storage unavailable', e);
      }
    }

    function saveCartToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_CART, JSON.stringify(cart));
      } catch (e) {
        console.warn('Storage unavailable', e);
      }
    }

    // =========================================================================
    // 4. TOAST FEEDBACK HELPER (No alert() used)
    // =========================================================================
    let toastTimer = null;
    function showToast(message) {
      const banner = document.getElementById('toast-banner');
      const msgEl = document.getElementById('toast-message');
      msgEl.textContent = message;
      banner.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
      banner.classList.add('opacity-100', 'translate-y-0');

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        banner.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        banner.classList.remove('opacity-100', 'translate-y-0');
      }, 2600);
    }

    // =========================================================================
    // 5. CATALOG RENDERING, SEARCH & FILTERING
    // =========================================================================
    function renderCategoryPills() {
      const container = document.getElementById('category-pills');
      container.innerHTML = CATEGORIES.map(cat => {
        const active = selectedCategory === cat;
        return `
          <button
            type="button"
            onclick="selectCategory('${cat}')"
            class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
              active
                ? 'bg-terracotta text-white shadow-sm'
                : 'bg-white text-warmGray border border-amberGold/25 hover:border-terracotta/50'
            }"
          >
            ${cat}
          </button>
        `;
      }).join('');
    }

    function selectCategory(cat) {
      selectedCategory = cat;
      renderCategoryPills();
      renderProducts();
    }

    function handleSearch(val) {
      searchQuery = val.trim().toLowerCase();
      renderProducts();
    }

    function clearFilters() {
      selectedCategory = 'All';
      searchQuery = '';
      document.getElementById('search-input').value = '';
      renderCategoryPills();
      renderProducts();
    }

    function renderProducts() {
      const grid = document.getElementById('product-grid');
      const emptyState = document.getElementById('empty-state');
      const countEl = document.getElementById('product-count');
      const headingEl = document.getElementById('catalog-heading');

      const filtered = products.filter(item => {
        const matchesCat = selectedCategory === 'All' || item.category === selectedCategory;
        const matchesSearch =
          !searchQuery ||
          item.name.toLowerCase().includes(searchQuery) ||
          item.description.toLowerCase().includes(searchQuery) ||
          item.category.toLowerCase().includes(searchQuery);
        return matchesCat && matchesSearch;
      });

      headingEl.textContent = selectedCategory === 'All' ? 'All Handcrafted Candles' : selectedCategory;
      countEl.textContent = `${filtered.length} ${filtered.length === 1 ? 'item' : 'items'}`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      grid.innerHTML = filtered.map(item => {
        const qtyInCart = cart[item.id] || 0;
        return `
          <article class="bg-white rounded-3xl overflow-hidden border border-amberGold/20 shadow-soft flex flex-col justify-between transition-transform duration-200 hover:-translate-y-0.5">
            <!-- Clickable Visual + Info -->
            <div onclick="openProductModal('${item.id}')" class="cursor-pointer">
              <div class="h-36 w-full relative overflow-hidden">
                ${getCandleArtworkSVG(item.art, false)}
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-full bg-white/90 backdrop-blur-xs text-[10px] font-semibold text-charcoal shadow-2xs">
                  ${item.category}
                </span>
              </div>
              <div class="p-3.5 pb-2">
                <p class="text-[10px] font-medium text-warmGray mb-0.5 truncate">${item.spec || 'Pure Soy • Cotton Wick'}</p>
                <h4 class="font-serif text-base font-bold text-charcoal leading-snug line-clamp-2 min-h-[2.5rem]">
                  ${item.name}
                </h4>
              </div>
            </div>

            <!-- Price & Action Row -->
            <div class="px-3.5 pb-3.5 pt-1">
              <div class="flex items-center justify-between gap-1.5">
                <span class="font-bold text-base text-terracotta">₹${item.price}</span>
                ${
                  qtyInCart > 0
                    ? `<div class="flex items-center bg-sand rounded-xl p-0.5 border border-terracotta/30">
                        <button type="button" onclick="updateCartItem('${item.id}', -1)" class="w-7 h-7 rounded-lg font-bold text-charcoal hover:bg-white">−</button>
                        <span class="px-2 text-xs font-bold text-charcoal">${qtyInCart}</span>
                        <button type="button" onclick="updateCartItem('${item.id}', 1)" class="w-7 h-7 rounded-lg font-bold text-charcoal hover:bg-white">+</button>
                      </div>`
                    : `<button
                        type="button"
                        onclick="updateCartItem('${item.id}', 1)"
                        class="px-3 py-2 rounded-xl bg-charcoal hover:bg-terracotta text-white text-xs font-semibold transition-colors"
                      >
                        + Add
                      </button>`
                }
              </div>

              <!-- Admin Quick Controls (Visible only in Manage Mode) -->
              ${
                isAdminMode
                  ? `<div class="mt-2.5 pt-2 border-t border-sand flex items-center justify-between gap-1.5">
                      <button
                        type="button"
                        onclick="editProduct('${item.id}')"
                        class="flex-1 py-1.5 rounded-lg bg-amberGold/20 text-charcoal text-[11px] font-semibold hover:bg-amberGold/35"
                      >
                        Edit
                      </button>
                      <button
                        type="button"
                        onclick="deleteProduct('${item.id}')"
                        class="flex-1 py-1.5 rounded-lg bg-red-50 text-red-600 text-[11px] font-semibold hover:bg-red-100"
                      >
                        Delete
                      </button>
                    </div>`
                  : ''
              }
            </div>
          </article>
        `;
      }).join('');
    }

    // =========================================================================
    // 6. PRODUCT DETAIL MODAL
    // =========================================================================
    function openProductModal(productId) {
      const product = products.find(p => p.id === productId);
      if (!product) return;

      activeModalProduct = product;
      activeModalQty = 1;

      document.getElementById('modal-art-container').innerHTML = getCandleArtworkSVG(product.art, true);
      document.getElementById('modal-category').textContent = product.category;
      document.getElementById('modal-spec').textContent = product.spec || 'Pure Soy • Cotton Wick';
      document.getElementById('modal-title').textContent = product.name;
      document.getElementById('modal-price').textContent = `₹${product.price}`;
      document.getElementById('modal-desc').textContent = product.description;
      document.getElementById('modal-wax-info').textContent = product.waxType || '100% Pure Soy Wax';
      updateModalQtyDisplay();

      document.getElementById('product-modal').classList.remove('hidden');
    }

    function closeProductModal() {
      document.getElementById('product-modal').classList.add('hidden');
      activeModalProduct = null;
    }

    function changeModalQty(delta) {
      activeModalQty = Math.max(1, activeModalQty + delta);
      updateModalQtyDisplay();
    }

    function updateModalQtyDisplay() {
      if (!activeModalProduct) return;
      document.getElementById('modal-qty').textContent = activeModalQty;
      const total = activeModalProduct.price * activeModalQty;
      document.getElementById('modal-add-btn').textContent = `Add to Order • ₹${total}`;
    }

    function addModalItemToCart() {
      if (!activeModalProduct) return;
      updateCartItem(activeModalProduct.id, activeModalQty);
      closeProductModal();
    }

    // =========================================================================
    // 7. CART MANAGEMENT & WHATSAPP CHECKOUT
    // =========================================================================
    function updateCartItem(productId, delta) {
      const product = products.find(p => p.id === productId);
      if (!product) return;

      const current = cart[productId] || 0;
      const next = current + delta;

      if (next <= 0) {
        delete cart[productId];
        showToast(`Removed ${product.name}`);
      } else {
        cart[productId] = next;
        if (delta > 0) {
          showToast(`Added ${product.name} (${next})`);
        }
      }

      saveCartToStorage();
      renderProducts();
      updateCartUI();
      if (!document.getElementById('cart-modal').classList.contains('hidden')) {
        renderCartDrawer();
      }
    }

    function getCartTotals() {
      let count = 0;
      let total = 0;
      Object.entries(cart).forEach(([id, qty]) => {
        const prod = products.find(p => p.id === id);
        if (prod && qty > 0) {
          count += qty;
          total += prod.price * qty;
        }
      });
      return { count, total };
    }

    function updateCartUI() {
      const { count, total } = getCartTotals();
      document.getElementById('cart-badge-count').textContent = count;
      document.getElementById('cart-bar-total').textContent = `₹${total}`;
      document.getElementById('cart-bar-subtitle').textContent =
        count > 0
          ? `${count} ${count === 1 ? 'candle' : 'candles'} selected • Tap to order`
          : 'Tap to view order details';
    }

    function openCartModal() {
      renderCartDrawer();
      document.getElementById('cart-modal').classList.remove('hidden');
    }

    function closeCartModal() {
      document.getElementById('cart-modal').classList.add('hidden');
    }

    function renderCartDrawer() {
      const container = document.getElementById('cart-items-container');
      const summaryBox = document.getElementById('cart-summary-box');
      const formBox = document.getElementById('checkout-form-box');
      const footerActions = document.getElementById('cart-footer-actions');

      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ product: products.find(p => p.id === id), qty }))
        .filter(entry => entry.product && entry.qty > 0);

      if (entries.length === 0) {
        container.innerHTML = `
          <div class="text-center py-10 px-4 bg-white rounded-2xl border border-amberGold/20">
            <p class="font-serif text-lg font-bold text-charcoal mb-1">Your order bag is empty</p>
            <p class="text-xs text-warmGray mb-4">Add handcrafted soy or gel candles from the catalog to place a WhatsApp order.</p>
            <button
              type="button"
              onclick="closeCartModal()"
              class="px-5 py-2.5 rounded-xl bg-terracotta text-white text-xs font-semibold"
            >
              Browse Candles
            </button>
          </div>
        `;
        summaryBox.classList.add('hidden');
        formBox.classList.add('hidden');
        footerActions.classList.add('hidden');
        return;
      }

      container.innerHTML = entries.map(({ product, qty }) => `
        <div class="bg-white p-3 rounded-2xl border border-amberGold/20 flex items-center justify-between gap-3">
          <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0">
            ${getCandleArtworkSVG(product.art, false)}
          </div>
          <div class="flex-1 min-w-0">
            <h5 class="font-serif text-sm font-bold text-charcoal truncate">${product.name}</h5>
            <p class="text-xs text-warmGray">₹${product.price} × ${qty} = <span class="font-bold text-terracotta">₹${product.price * qty}</span></p>
          </div>
          <div class="flex items-center bg-sand rounded-xl p-0.5 shrink-0">
            <button type="button" onclick="updateCartItem('${product.id}', -1)" class="w-7 h-7 rounded-lg font-bold text-charcoal hover:bg-white">−</button>
            <span class="px-2 text-xs font-bold">${qty}</span>
            <button type="button" onclick="updateCartItem('${product.id}', 1)" class="w-7 h-7 rounded-lg font-bold text-charcoal hover:bg-white">+</button>
          </div>
        </div>
      `).join('');

      const { total } = getCartTotals();
      document.getElementById('summary-subtotal').textContent = `₹${total}`;
      document.getElementById('summary-total').textContent = `₹${total}`;

      summaryBox.classList.remove('hidden');
      formBox.classList.remove('hidden');
      footerActions.classList.remove('hidden');
    }

    function buildWhatsAppOrderMessage() {
      const name = document.getElementById('cust-name').value.trim();
      const phone = document.getElementById('cust-phone').value.trim();
      const address = document.getElementById('cust-address').value.trim();
      const note = document.getElementById('cust-note').value.trim();

      if (!name || !phone || !address) {
        showToast('Please enter Name, Phone & Delivery Address');
        return null;
      }

      const entries = Object.entries(cart)
        .map(([id, qty]) => ({ product: products.find(p => p.id === id), qty }))
        .filter(entry => entry.product && entry.qty > 0);

      if (entries.length === 0) {
        showToast('Your cart is empty');
        return null;
      }

      const { total } = getCartTotals();
      const lines = [
        `🕯️ *New Order — Diyan's Candle Co.*`,
        `────────────────────`,
        ...entries.map(
          ({ product, qty }, idx) =>
            `${idx + 1}. *${product.name}*\n   Qty: ${qty} × ₹${product.price} = ₹${product.price * qty}`
        ),
        `────────────────────`,
        `*Total Amount: ₹${total}*`,
        ``,
        `👤 *Customer Details:*`,
        `• Name: ${name}`,
        `• Phone: ${phone}`,
        `• Address: ${address}`,
        ...(note ? [`• Note: ${note}`] : []),
        ``,
        `Please confirm availability & payment details. Thank you!`
      ];

      return lines.join('\n');
    }

    function sendOrderOnWhatsApp() {
      const message = buildWhatsAppOrderMessage();
      if (!message) return;

      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
      showToast('Opening WhatsApp with your order...');
    }

    function copyOrderSummary() {
      const message = buildWhatsAppOrderMessage();
      if (!message) return;

      const tempInput = document.createElement('textarea');
      tempInput.value = message;
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand('copy');
        showToast('Order summary copied! Paste in WhatsApp.');
      } catch (err) {
        showToast('Unable to copy text automatically.');
      }
      document.body.removeChild(tempInput);
    }

    // =========================================================================
    // 8. ADMIN / QUICK PRODUCT MANAGER MODE
    // =========================================================================
    function toggleAdminMode() {
      isAdminMode = !isAdminMode;
      const panel = document.getElementById('admin-panel');
      const btn = document.getElementById('toggle-admin-btn');
      const label = document.getElementById('admin-btn-label');

      if (isAdminMode) {
        panel.classList.remove('hidden');
        btn.classList.add('bg-terracotta', 'text-white');
        label.textContent = 'Done';
        showToast('Catalog Manager Enabled');
      } else {
        panel.classList.add('hidden');
        btn.classList.remove('bg-terracotta', 'text-white');
        label.textContent = 'Manage';
        resetProductForm();
      }
      renderProducts();
    }

    function handleSaveProduct(event) {
      event.preventDefault();
      const editId = document.getElementById('edit-product-id').value;
      const name = document.getElementById('prod-name').value.trim();
      const category = document.getElementById('prod-category').value;
      const price = parseInt(document.getElementById('prod-price').value, 10);
      const art = document.getElementById('prod-art').value;
      const spec = document.getElementById('prod-spec').value.trim() || 'Pure Soy • Cotton Wick';
      const description = document.getElementById('prod-desc').value.trim();

      if (!name || isNaN(price) || price <= 0) {
        showToast('Please enter valid candle name & price');
        return;
      }

      if (editId) {
        const index = products.findIndex(p => p.id === editId);
        if (index !== -1) {
          products[index] = {
            ...products[index],
            name,
            category,
            price,
            art,
            spec,
            description
          };
          showToast('Candle updated!');
        }
      } else {
        const newProduct = {
          id: 'candle-' + Date.now(),
          name,
          category,
          price,
          art,
          spec,
          waxType: '100% Pure Soy Wax',
          description
        };
        products.unshift(newProduct);
        showToast('New candle added to catalog!');
      }

      saveProductsToStorage();
      resetProductForm();
      renderProducts();
      updateCartUI();
    }

    function editProduct(productId) {
      const product = products.find(p => p.id === productId);
      if (!product) return;

      document.getElementById('edit-product-id').value = product.id;
      document.getElementById('prod-name').value = product.name;
      document.getElementById('prod-category').value = product.category;
      document.getElementById('prod-price').value = product.price;
      document.getElementById('prod-art').value = product.art || 'jar';
      document.getElementById('prod-spec').value = product.spec || 'Pure Soy • Cotton Wick';
      document.getElementById('prod-desc').value = product.description;

      document.getElementById('save-prod-btn').textContent = 'Save Changes';
      document.getElementById('cancel-edit-btn').classList.remove('hidden');
      document.getElementById('admin-panel').scrollIntoView({ behavior: 'smooth' });
    }

    function deleteProduct(productId) {
      products = products.filter(p => p.id !== productId);
      delete cart[productId];
      saveProductsToStorage();
      saveCartToStorage();
      renderProducts();
      updateCartUI();
      showToast('Candle removed from catalog');
    }

    function resetProductForm() {
      document.getElementById('product-form').reset();
      document.getElementById('edit-product-id').value = '';
      document.getElementById('prod-spec').value = 'Pure Soy • Cotton Wick';
      document.getElementById('save-prod-btn').textContent = '+ Add Candle to Catalog';
      document.getElementById('cancel-edit-btn').classList.add('hidden');
    }

    function resetDefaultProducts() {
      products = [...DEFAULT_PRODUCTS];
      saveProductsToStorage();
      resetProductForm();
      renderProducts();
      updateCartUI();
      showToast('Default candle catalog restored');
    }

    // Start app on load
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
