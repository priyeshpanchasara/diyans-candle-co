<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Diyan's Candle Co. — Handcrafted Pure Soy & Gel Wax Candles</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Cormorant Garamond for Luxury Serif Headings & Plus Jakarta Sans for Clean UI -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            cream: '#FAF7F2',
            sand: '#F2EBE1',
            terracotta: '#C87D55',
            amberGold: '#D4A373',
            charcoal: '#2B2623',
            warmGray: '#6E655F',
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          },
          boxShadow: {
            'soft': '0 10px 30px -10px rgba(43, 38, 35, 0.08)',
            'float': '0 14px 34px -6px rgba(200, 125, 85, 0.35)',
          }
        }
      }
    }
  </script>
  <style>
    /* Smooth scrolling and mobile-app feel */
    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }
    body {
      background-color: #EFEAE2;
      color: #2B2623;
      font-family: 'Plus Jakarta Sans', sans-serif;
      margin: 0;
      padding: 0;
    }
    /* Hide scrollbar for clean horizontal pills */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    /* Subtle candle flame flicker animation */
    @keyframes flicker {
      0%, 100% { transform: scale(1) rotate(-1deg); opacity: 0.95; }
      50% { transform: scale(1.06) rotate(1.5deg); opacity: 1; }
    }
    .flame-glow {
      transform-origin: center bottom;
      animation: flicker 2.4s infinite ease-in-out;
    }
  </style>
</head>
<body class="min-h-screen flex justify-center items-start">

  <!-- Mobile App Shell Container (Full width on mobile, centered app frame on desktop) -->
  <div id="app-shell" class="w-full max-w-md min-h-screen bg-cream relative shadow-2xl flex flex-col overflow-x-hidden pb-28">

    <!-- Top Sticky App Header -->
    <header class="sticky top-0 z-30 bg-cream/95 backdrop-blur-md border-b border-amberGold/20 px-4 py-3.5 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Minimalist Brand Flame Emblem -->
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-terracotta to-amberGold flex items-center justify-center text-white shadow-sm shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2C12 2 7 7.5 7 12.5C7 15.2614 9.23858 17.5 12 17.5C14.7614 17.5 17 15.2614 17 12.5C17 7.5 12 2 12 2Z" fill="rgba(255,255,255,0.25)"/>
            <path d="M9 21H15M12 17.5V21" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="min-w-0">
          <h1 class="font-serif text-xl font-bold leading-tight text-charcoal truncate">Diyan's Candle Co.</h1>
          <p class="text-[11px] text-warmGray font-medium truncate">Pure Soy &amp; Gel Wax Candles</p>
        </div>
      </div>

      <!-- Manage Products Mode Toggle -->
      <button
        id="toggle-admin-btn"
        type="button"
        onclick="toggleAdminMode()"
        class="px-3 py-2 rounded-xl text-xs font-semibold border border-terracotta/30 bg-sand/70 text-charcoal hover:bg-terracotta hover:text-white transition-all flex items-center gap-1.5 shrink-0"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span id="admin-btn-label">Manage</span>
      </button>
    </header>

    <!-- Toast Notification Banner (Replaces alert) -->
    <div id="toast-banner" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-sm pointer-events-none opacity-0 transition-all duration-300 transform -translate-y-2">
      <div id="toast-content" class="bg-charcoal text-cream px-4 py-3 rounded-2xl shadow-xl text-xs font-medium flex items-center justify-between gap-2 border border-amberGold/30">
        <span id="toast-message">Action completed</span>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-1 px-4 pt-4">

      <!-- Artisanal Hero Banner -->
      <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#352C27] via-[#4A382E] to-[#7D4F38] text-cream p-5 mb-5 shadow-soft">
        <div class="relative z-10 max-w-[75%]">
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-amberGold/20 text-amberGold text-[10px] font-semibold tracking-wider uppercase mb-2">
            Hand-Poured in Small Batches
          </span>
          <h2 class="font-serif text-2xl font-bold leading-snug mb-1.5">
            Warm Glow for Every Corner
          </h2>
          <p class="text-xs text-cream/80 leading-relaxed mb-3">
            Handcrafted Pure Soy &amp; Gel Wax Candles with clean-burning cotton wicks.
          </p>
          <button
            type="button"
            onclick="document.getElementById('catalog-section').scrollIntoView({ behavior: 'smooth' })"
            class="px-4 py-2 rounded-xl bg-terracotta hover:bg-amberGold text-white text-xs font-semibold transition-colors shadow-sm"
          >
            Explore Collection
          </button>
        </div>
        <!-- Decorative SVG Glow -->
        <svg class="w-28 h-28 absolute -right-3 -bottom-3 text-amberGold/25" viewBox="0 0 100 100" fill="none">
          <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4"/>
          <path d="M50 18C50 18 34 36 34 52C34 60.8 41.2 68 50 68C58.8 68 66 60.8 66 52C66 36 50 18 50 18Z" fill="currentColor"/>
        </svg>
      </section>

      <!-- Admin / Quick Product Manager Panel (Hidden by default) -->
      <section id="admin-panel" class="hidden mb-6 rounded-3xl bg-white border-2 border-terracotta/40 p-4 shadow-soft">
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-sand">
          <div>
            <h3 class="font-serif text-lg font-bold text-charcoal">Catalog Manager</h3>
            <p class="text-[11px] text-warmGray">Add new candles or edit existing prices</p>
          </div>
          <button
            type="button"
            onclick="resetDefaultProducts()"
            class="text-[11px] font-semibold text-terracotta underline px-2 py-1"
          >
            Reset Defaults
          </button>
        </div>

        <!-- Add / Edit Candle Form -->
        <form id="product-form" onsubmit="handleSaveProduct(event)" class="space-y-3">
          <input type="hidden" id="edit-product-id" value="" />
          <div>
            <label class="block text-[11px] font-semibold text-warmGray mb-1">Candle Name *</label>
            <input
              type="text"
              id="prod-name"
              required
              placeholder="e.g., Rose Petal Soy Jar Candle"
              class="w-full px-3.5 py-2.5 rounded-xl bg-cream border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
            />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Category *</label>
              <select
                id="prod-category"
                class="w-full px-3 py-2.5 rounded-xl bg-cream border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              >
                <option value="Heart & Shell">Heart &amp; Shell</option>
                <option value="Floating & Urli">Floating &amp; Urli</option>
                <option value="Jar Candles">Jar Candles</option>
                <option value="Gift Sets">Gift Sets</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Price (₹) *</label>
              <input
                type="number"
                id="prod-price"
                required
                min="1"
                placeholder="349"
                class="w-full px-3.5 py-2.5 rounded-xl bg-cream border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Art Style</label>
              <select
                id="prod-art"
                class="w-full px-3 py-2.5 rounded-xl bg-cream border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              >
                <option value="heart">Multi-Wick Heart</option>
                <option value="shell">Pearl Conch Shell</option>
                <option value="floating">Floating Flowers</option>
                <option value="urli">Golden Metal Urli</option>
                <option value="boat">Oval Boat Multi-Wick</option>
                <option value="hamper">Festive Gift Set</option>
                <option value="jar">Classic Soy Jar</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Spec Badge</label>
              <input
                type="text"
                id="prod-spec"
                placeholder="Pure Soy • Cotton Wick"
                value="Pure Soy • Cotton Wick"
                class="w-full px-3 py-2.5 rounded-xl bg-cream border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-semibold text-warmGray mb-1">Description *</label>
            <textarea
              id="prod-desc"
              rows="2"
              required
              placeholder="Handcrafted pure soy wax candle with cotton wick..."
              class="w-full px-3.5 py-2 rounded-xl bg-cream border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
            ></textarea>
          </div>

          <div class="flex gap-2 pt-1">
            <button
              type="submit"
              id="save-prod-btn"
              class="flex-1 py-2.5 rounded-xl bg-terracotta text-white text-xs font-bold hover:bg-charcoal transition-colors"
            >
              + Add Candle to Catalog
            </button>
            <button
              type="button"
              id="cancel-edit-btn"
              onclick="resetProductForm()"
              class="hidden px-4 py-2.5 rounded-xl bg-sand text-charcoal text-xs font-semibold"
            >
              Cancel
            </button>
          </div>
        </form>
      </section>

      <!-- Search & Filter Section -->
      <section id="catalog-section" class="mb-4">
        <!-- Search Input -->
        <div class="relative mb-3">
          <svg class="w-4 h-4 text-warmGray absolute left-3.5 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/>
          </svg>
          <input
            type="text"
            id="search-input"
            oninput="handleSearch(this.value)"
            placeholder="Search soy candles, urli, shell, gift sets..."
            class="w-full pl-10 pr-4 py-3 rounded-2xl bg-white border border-amberGold/25 text-sm placeholder:text-warmGray/70 focus:outline-none focus:border-terracotta shadow-sm"
          />
        </div>

        <!-- Category Pills -->
        <div id="category-pills" class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
          <!-- Populated dynamically via JS -->
        </div>
      </section>

      <!-- Product Grid Header -->
      <div class="flex items-center justify-between mb-3">
        <h3 id="catalog-heading" class="font-serif text-xl font-bold text-charcoal">All Handcrafted Candles</h3>
        <span id="product-count" class="text-xs font-medium text-warmGray">6 items</span>
      </div>

      <!-- Product Cards Grid -->
      <section id="product-grid" class="grid grid-cols-2 gap-3.5 pb-6">
        <!-- Product cards injected via JS -->
      </section>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-12 px-4 bg-white rounded-3xl border border-amberGold/20">
        <p class="font-serif text-lg font-bold text-charcoal mb-1">No candles found</p>
        <p class="text-xs text-warmGray mb-3">Try clearing your search or switching category filters.</p>
        <button
          type="button"
          onclick="clearFilters()"
          class="px-4 py-2 rounded-xl bg-terracotta text-white text-xs font-semibold"
        >
          Show All Candles
        </button>
      </div>

      <!-- Footer Brand Info -->
      <footer class="mt-4 pt-5 border-t border-amberGold/20 text-center text-xs text-warmGray pb-4">
        <p class="font-serif text-base font-bold text-charcoal">Diyan's Candle Co.</p>
        <p class="mt-0.5">Handcrafted Pure Soy &amp; Gel Wax Candles</p>
        <p class="mt-1 text-[11px] opacity-80">Custom bulk &amp; festive orders available via WhatsApp</p>
      </footer>
    </main>

    <!-- Floating Bottom Cart Bar -->
    <div id="floating-cart-bar" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-30 w-[92%] max-w-[416px] transition-all duration-300">
      <button
        type="button"
        onclick="openCartModal()"
        class="w-full bg-charcoal hover:bg-[#3A332F] text-cream px-4 py-3.5 rounded-2xl shadow-float flex items-center justify-between border border-amberGold/30 active:scale-[0.99] transition-transform"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-terracotta flex items-center justify-center font-bold text-sm text-white relative">
            <span id="cart-badge-count">0</span>
          </div>
          <div class="text-left">
            <p class="text-xs font-semibold text-cream">Your Candle Order</p>
            <p id="cart-bar-subtitle" class="text-[11px] text-amberGold">Tap to review &amp; send on WhatsApp</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="cart-bar-total" class="font-bold text-base text-white">₹0</span>
          <svg class="w-4 h-4 text-amberGold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </button>
    </div>

    <!-- Product Detail Modal -->
    <div id="product-modal" class="fixed inset-0 z-40 hidden bg-charcoal/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4">
      <div class="bg-cream w-full max-w-md rounded-t-3xl sm:rounded-3xl overflow-hidden shadow-2xl max-h-[90vh] flex flex-col animate-slide-up">
        <!-- Close Button -->
        <div class="relative">
          <button
            type="button"
            onclick="closeProductModal()"
            aria-label="Close details"
            class="absolute top-3.5 right-3.5 z-10 w-9 h-9 rounded-full bg-white/90 text-charcoal flex items-center justify-center shadow-md hover:bg-white"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
            </svg>
          </button>
          <!-- Bespoke SVG Art Header -->
          <div id="modal-art-container" class="w-full h-56 flex items-center justify-center p-6">
            <!-- SVG Injected Here -->
          </div>
        </div>

        <div class="p-5 overflow-y-auto flex-1">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <span id="modal-category" class="px-2.5 py-0.5 rounded-full bg-sand text-terracotta text-[11px] font-semibold">
              Category
            </span>
            <span id="modal-spec" class="text-[11px] font-medium text-warmGray">
              Pure Soy • Cotton Wick
            </span>
          </div>

          <h3 id="modal-title" class="font-serif text-2xl font-bold text-charcoal leading-snug mb-1">
            Candle Name
          </h3>
          <p id="modal-price" class="text-xl font-bold text-terracotta mb-3">₹349</p>

          <p id="modal-desc" class="text-xs text-warmGray leading-relaxed mb-4">
            Detailed candle description goes here.
          </p>

          <!-- Artisanal Highlights -->
          <div class="grid grid-cols-2 gap-2 mb-5">
            <div class="p-2.5 rounded-2xl bg-white border border-amberGold/20">
              <p class="text-[10px] uppercase tracking-wider text-warmGray font-semibold">Wax Blend</p>
              <p id="modal-wax-info" class="text-xs font-bold text-charcoal mt-0.5">100% Pure Soy Wax</p>
            </div>
            <div class="p-2.5 rounded-2xl bg-white border border-amberGold/20">
              <p class="text-[10px] uppercase tracking-wider text-warmGray font-semibold">Wick Type</p>
              <p class="text-xs font-bold text-charcoal mt-0.5">Braided Cotton Wick</p>
            </div>
          </div>

          <!-- Quantity & Add Button -->
          <div class="flex items-center gap-3">
            <div class="flex items-center bg-white border border-amberGold/30 rounded-2xl p-1">
              <button
                type="button"
                onclick="changeModalQty(-1)"
                class="w-9 h-9 rounded-xl flex items-center justify-center text-charcoal font-bold hover:bg-sand"
              >−</button>
              <span id="modal-qty" class="w-8 text-center font-bold text-sm">1</span>
              <button
                type="button"
                onclick="changeModalQty(1)"
                class="w-9 h-9 rounded-xl flex items-center justify-center text-charcoal font-bold hover:bg-sand"
              >+</button>
            </div>

            <button
              type="button"
              id="modal-add-btn"
              onclick="addModalItemToCart()"
              class="flex-1 py-3.5 px-4 rounded-2xl bg-terracotta hover:bg-charcoal text-white font-bold text-sm transition-colors shadow-sm"
            >
              Add to Order • ₹349
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Cart & WhatsApp Order Checkout Drawer/Modal -->
    <div id="cart-modal" class="fixed inset-0 z-40 hidden bg-charcoal/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4">
      <div class="bg-cream w-full max-w-md rounded-t-3xl sm:rounded-3xl shadow-2xl max-h-[92vh] flex flex-col overflow-hidden">
        <!-- Drawer Header -->
        <div class="px-5 py-4 bg-white border-b border-sand flex items-center justify-between">
          <div>
            <h3 class="font-serif text-xl font-bold text-charcoal">Your Candle Order</h3>
            <p class="text-[11px] text-warmGray">Review items &amp; send directly on WhatsApp</p>
          </div>
          <button
            type="button"
            onclick="closeCartModal()"
            class="w-9 h-9 rounded-full bg-sand/70 text-charcoal flex items-center justify-center hover:bg-sand"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <!-- Drawer Scrollable Body -->
        <div class="p-5 overflow-y-auto flex-1 space-y-5">
          <!-- Selected Cart Items List -->
          <div id="cart-items-container" class="space-y-2.5">
            <!-- Injected via JS -->
          </div>

          <!-- Order Summary Card -->
          <div id="cart-summary-box" class="hidden bg-white rounded-2xl p-4 border border-amberGold/25 space-y-2">
            <div class="flex justify-between text-xs text-warmGray">
              <span>Subtotal</span>
              <span id="summary-subtotal">₹0</span>
            </div>
            <div class="flex justify-between text-xs text-warmGray">
              <span>Packaging</span>
              <span class="text-emerald-700 font-medium">Artisanal Safe Wrap Included</span>
            </div>
            <div class="pt-2 border-t border-sand flex justify-between items-center">
              <span class="font-bold text-sm text-charcoal">Estimated Total</span>
              <span id="summary-total" class="font-bold text-lg text-terracotta">₹0</span>
            </div>
          </div>

          <!-- Customer Details Form for WhatsApp -->
          <div id="checkout-form-box" class="hidden space-y-3">
            <h4 class="font-serif text-lg font-bold text-charcoal">Delivery &amp; Contact Details</h4>

            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Your Name *</label>
              <input
                type="text"
                id="cust-name"
                placeholder="Enter your full name"
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              />
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Phone / WhatsApp Number *</label>
              <input
                type="tel"
                id="cust-phone"
                placeholder="e.g., 98765 43210"
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              />
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Delivery City &amp; Address *</label>
              <textarea
                id="cust-address"
                rows="2"
                placeholder="House/Flat No., Area, City, Pincode"
                class="w-full px-3.5 py-2 rounded-xl bg-white border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              ></textarea>
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-warmGray mb-1">Custom Note / Fragrance Preference (Optional)</label>
              <input
                type="text"
                id="cust-note"
                placeholder="e.g., Gift message, color preference..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-amberGold/30 text-sm focus:outline-none focus:border-terracotta"
              />
            </div>
          </div>
        </div>

        <!-- Drawer Footer Actions -->
        <div id="cart-footer-actions" class="hidden p-4 bg-white border-t border-sand space-y-2">
          <button
            type="button"
            onclick="sendOrderOnWhatsApp()"
            class="w-full py-3.5 px-4 rounded-2xl bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold text-sm flex items-center justify-center gap-2 shadow-md transition-colors"
          >
            <!-- WhatsApp SVG Icon -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
